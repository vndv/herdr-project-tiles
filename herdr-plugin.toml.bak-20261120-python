id = "vndv.project-tiles"
name = "Project Tiles"
version = "0.1.0"
min_herdr_version = "0.9.5"
description = "Tile dashboard of projects: git status, languages, collections; opens projects as workspaces"
platforms = ["macos", "linux"]

# The dashboard itself: a full-screen overlay over the current tab.
[[panes]]
id = "tiles"
title = "Project Tiles"
placement = "overlay"
command = ["/bin/sh", "bin/run.sh"]

# Bound in config.toml:  type = "plugin_action", command = "vndv.project-tiles.open"
[[actions]]
id = "open"
title = "Project Tiles: open dashboard"
contexts = ["global", "workspace", "tab", "pane"]
command = ["/bin/sh", "-c", "exec \"${HERDR_BIN_PATH:-herdr}\" plugin pane open --plugin vndv.project-tiles --entrypoint tiles"]

[[actions]]
id = "add-current"
title = "Project Tiles: add current folder"
contexts = ["workspace", "tab", "pane"]
command = ["/bin/sh", "bin/run.sh", "--add-current"]
